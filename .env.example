# Application under test
BASE_URL=https://www.saucedemo.com

# Keep credentials in .env or CI secrets; do not commit real secrets.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Browser and execution settings
HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=10000
IGNORE_HTTPS_ERRORS=false
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
ARTIFACTS_DIR=test-results
LOG_LEVEL=INFO
